# Groq API key — used by the in-app AI guidance + Whisper STT + vision triage.
# Get one (free tier) at https://console.groq.com/keys
# CRA exposes any REACT_APP_* var to the client at build time, so for production
# you should proxy this through a serverless function instead of shipping it.
REACT_APP_GROQ_API_KEY=your_groq_key_here

# RapidAPI key — used for YouTube video suggestions in Triage and Guidance.
# Get a free key at https://rapidapi.com/ and subscribe to "youtube-v31".
# Free tier is ~500 requests/month, plenty for a demo.
REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# Optional — override the RapidAPI host. Defaults to youtube-v31.p.rapidapi.com.
# Useful if you want to swap in a different YouTube provider on RapidAPI.
# REACT_APP_RAPIDAPI_HOST=youtube-v31.p.rapidapi.com
